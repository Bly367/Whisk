# Deployed Supabase Edge Function URLs:
EXPO_PUBLIC_IMPORT_API_URL=https://YOUR_PROJECT.supabase.co/functions/v1/import-recipe
EXPO_PUBLIC_IMPORT_IMAGE_API_URL=https://YOUR_PROJECT.supabase.co/functions/v1/import-recipe-image

# Supabase project URL (for auth + cloud sync)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Public Supabase key. Safe for client-side use; never put a secret key here.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
